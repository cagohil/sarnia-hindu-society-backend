PORT=8000
# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
# Database name inside the cluster (overrides the one in MONGO_URI)
MONGO_DB_NAME=test
# Secret used to sign admin login tokens
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=*
# Optional, local dev only: DNS servers to use if mongodb+srv lookups fail (e.g. 1.1.1.1,8.8.8.8)
# DNS_SERVERS=
